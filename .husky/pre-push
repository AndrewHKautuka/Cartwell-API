#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

## husky task runner examples -------------------
## Note : for local installation use 'dotnet' prefix. e.g. 'dotnet husky'

## run all tasks
#husky run

### run all tasks with group: 'group-name'
#husky run --group group-name

## run task with name: 'task-name'
#husky run --name task-name

## pass hook arguments to task
#husky run --args "$1" "$2"

## or put your custom commands -------------------
#echo 'Husky.Net is awesome!'

while IFS=' ' read -r local_ref local_sha _ _; do
  if [ "$local_ref" = "refs/heads/main" ]; then
    parent_count=$(git cat-file -p "$local_sha" | grep -c "^parent ")
    if [ "$parent_count" -lt 2 ]; then
      echo "Push blocked: main's tip is not a merge commit."
      echo "Did you use 'git release' or forget 'git merge -s ours dev'?"
      exit 1
    fi
  fi
done

echo 'Format Solution'
dotnet format --no-restore
